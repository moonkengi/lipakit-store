# =============================================================================
# LipaKit environment variables
# Copy to .env.local and fill in. Never commit real values.
# Everything here is validated on boot by src/lib/env.ts.
# =============================================================================

# --- App ---------------------------------------------------------------------
# Public URL of the app, no trailing slash. Used for auth redirects and
# M-Pesa callback URLs (Daraja needs a public HTTPS URL; see docs/02-mpesa-sandbox.md).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- M-Pesa (Daraja) -----------------------------------------------------------
# simulator  = no Safaricom calls; fake callbacks fired at your own app (default).
#              Local only: refused on a Vercel production deployment.
# sandbox    = https://sandbox.safaricom.co.ke
# production = https://api.safaricom.co.ke
MPESA_MODE=simulator
# From your app on developer.safaricom.co.ke. Required unless MPESA_MODE=simulator.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Business shortcode (Paybill or Till) and Lipa Na M-Pesa Online passkey.
# Safaricom's public sandbox shortcode is 174379; its passkey is on the Daraja test credentials page.
MPESA_SHORTCODE=
MPESA_PASSKEY=
# paybill or till. Decides the STK TransactionType.
MPESA_TILL_OR_PAYBILL=paybill
# Buy Goods only: the till number customers pay (PartyB), if it differs from MPESA_SHORTCODE (the store number).
MPESA_TILL_NUMBER=
# Secret path segment in callback URLs (/api/hooks/<token>/stk). The path avoids words Safaricom blocks in URLs.
# At least 24 characters. Generate one with: openssl rand -hex 24
MPESA_CALLBACK_TOKEN=replace-with-openssl-rand-hex-24-output
# C2B validation: "accept" (default) takes every payment; "match" rejects account numbers
# that don't match an order. Validation only runs if Safaricom enabled it on your shortcode.
MPESA_C2B_VALIDATION=accept
# Offer M-Pesa Ratiba standing orders as auto-renew (true/false). Production needs Safaricom's approval.
MPESA_RATIBA_ENABLED=false
# B2C payouts (Pro). Initiator name and its encrypted security credential from the
# Daraja portal. Set both, or leave both blank to disable payouts.
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=

# --- Africa's Talking (SMS) — optional; SMS is skipped when blank --------------
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- Resend (email) — optional; email is skipped when blank --------------------
RESEND_API_KEY=
# e.g. "LipaKit <billing@yourdomain.co.ke>" (domain must be verified in Resend)
EMAIL_FROM=

# --- Telegram — optional --------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# The bot's username without @ (for the "Link Telegram" button).
TELEGRAM_BOT_USERNAME=
# Random string Telegram echoes back in a header so we know the webhook is genuine.
# 16-256 chars of letters, digits, _ and -. Generate: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated chat IDs that receive admin alerts.
TELEGRAM_ADMIN_CHAT_IDS=

# --- Paystack instead of your own shortcode (optional) -------------------------------
# No Paybill/Till yet? Send STK pushes through Paystack. See docs/11-paystack.md.
# daraja (default) | paystack. Ignored when MPESA_MODE=simulator.
PAYMENT_PROVIDER=daraja
# Paystack → Settings → API Keys & Webhooks. sk_test_... while testing. Server only, never commit it.
PAYSTACK_SECRET_KEY=

# --- Analytics (optional) ------------------------------------------------------------
# PostHog project API key (phc_..., public by design) and region (eu or us). When set, the
# app records page views, session replays (inputs masked), checkout_started and
# payment_succeeded. Browser traffic goes through /ingest on your own domain.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_REGION=eu

# --- Phone sign-in (optional) -------------------------------------------------------
# Supabase → Authentication → Hooks → Send SMS hook → secret (v1,whsec_...). Also set
# phoneOtp: true in src/config/features.ts. Uses the Africa's Talking keys above.
SUPABASE_SMS_HOOK_SECRET=

# --- Admin alerts: Slack, Discord, generic webhook — all optional ----------------
# Slack: Apps → Incoming Webhooks. Discord: Server Settings → Integrations → Webhooks.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
# Every event as signed JSON to your own URL (Zapier, n8n, your backend).
# Verify with verifyWebhookSignature() from src/lib/alerts/webhook.ts.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# --- Web push — optional ------------------------------------------------------------
# Generate a key pair once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- B2C payouts (Pro) ----------------------------------------------------------------
# Safety brake on all payouts per day (KES, Nairobi time). Not a Safaricom limit.
B2C_DAILY_LIMIT_KES=50000

# --- Jobs & billing ---------------------------------------------------------------
# Sent as "Authorization: Bearer <CRON_SECRET>" by the scheduler (pg_cron). At least 16 characters.
CRON_SECRET=replace-with-openssl-rand-hex-24-output
# Days a subscription stays usable after its period ends unpaid.
GRACE_DAYS=3

# --- Licence (optional) -----------------------------------------------------------------
# Your licence key, from the .lipakit-license file that came with the kit. Only shown on
# the admin Health page so you know your tier and update window; the app works without it.
LIPAKIT_LICENSE_KEY=
